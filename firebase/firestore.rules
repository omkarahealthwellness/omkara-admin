rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// FIRESTORE SECURITY RULES — SYSTEM LOCKED (T3)
//
// Deployed ONLY via CI (firebase/rules.yml). Never editable from admin panel.
// CI diffs remote rules vs this file to detect console tampering.
//
// Design: deny-by-default, admin-only (including reads).
// The storefront NEVER reads Firestore — it reads the manifest from R2.
// Therefore, there is no reason for any non-admin to ever access Firestore.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from an authenticated user explicitly listed in admin_users?
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.role == 'admin' || exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)));
    }

    // Helper: check document size (defense in depth)
    function isReasonableSize() {
      return request.resource.data.keys().size() < 50;
    }

    // ─── Default: deny everything ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Drafts singleton (store settings, navigation, hero, etc.) ──────
    match /drafts/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isReasonableSize();
    }

    // ─── Categories ─────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isReasonableSize();
      allow update: if isAdmin() && isReasonableSize();
      allow delete: if isAdmin();
    }

    // ─── Products ───────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isReasonableSize();
      allow update: if isAdmin() && isReasonableSize() && 
                    request.resource.data.slug == resource.data.slug &&
                    request.resource.data.id == resource.data.id;
      allow delete: if isAdmin();
    }

    // ─── Tags ───────────────────────────────────────────────────────────
    match /tags/{tagId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isReasonableSize();
      allow update: if isAdmin() && isReasonableSize();
      allow delete: if isAdmin();
    }

    // ─── Audit log (append-only — no update, no delete) ─────────────────
    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      // Explicitly deny update and delete — audit trail is immutable
      allow update: if false;
      allow delete: if false;
    }

    // ─── Settings (global config) ───────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isReasonableSize();
    }

    // ─── Admin Users (Read-only for rules) ──────────────────────────────
    match /admin_users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only manageable via Firebase Console / CLI
    }
  }
}
